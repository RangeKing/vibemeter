{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeMeter",
  "version": "0.1.4",
  "identifier": "com.vibemeter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "VibeMeter",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Track your agents. Discover your coding type.",
    "longDescription": "Live agent monitoring, local AI coding analytics, and an evolving VCTI profile.",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/VibeMeter-dmg-background.png",
        "windowSize": {
          "width": 860,
          "height": 540
        },
        "windowPosition": {
          "x": 240,
          "y": 180
        },
        "appPosition": {
          "x": 220,
          "y": 270
        },
        "applicationFolderPosition": {
          "x": 640,
          "y": 270
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
