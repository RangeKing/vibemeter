{
  "name": "vibemeter",
  "version": "0.4.3",
  "description": "Track your agents. Discover your coding type.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RangeKing/vibemeter.git"
  },
  "homepage": "https://github.com/RangeKing/vibemeter#readme",
  "bugs": {
    "url": "https://github.com/RangeKing/vibemeter/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run tauri --workspace @vibemeter/desktop -- dev",
    "build": "npm run tauri --workspace @vibemeter/desktop -- build",
    "check": "npm run check --workspace @vibemeter/desktop",
    "test": "npm run test --workspace @vibemeter/desktop",
    "pricing:update": "python3 scripts/update_api_pricing.py",
    "dmg:setup": "python3 -m venv .dmg-venv && .dmg-venv/bin/python -m pip install --disable-pip-version-check -r scripts/requirements-dmg.txt",
    "dmg:finalize": "PATH=\"$PWD/.dmg-venv/bin:$PATH\" bash scripts/finalize-dmg.sh",
    "dmg:check": "PATH=\"$PWD/.dmg-venv/bin:$PATH\" bash scripts/check-dmg-layout.sh",
    "rust:check": "cd apps/desktop/src-tauri && cargo fmt --all -- --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "ci": "npm run check && npm test && npm run rust:check"
  }
}
